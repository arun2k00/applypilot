# Docker Compose publishes the frontend on loopback only.
APPLYPILOT_WEB_PORT=3000
APPLYPILOT_ORIGIN=http://localhost:3000

# Optional. Leave empty for SQLite. Supply private credentials outside Git.
# APPLYPILOT_DATABASE_URL=postgresql+psycopg://username:password@host/database

# Exact comma-separated URLs. Leave blank until you authorize a source or custom endpoint.
APPLYPILOT_AUTHORIZED_FEEDS=
APPLYPILOT_ALLOWED_PROVIDER_ENDPOINTS=
APPLYPILOT_SCHEDULER=1

# Optional Fernet key supplied by your local secrets manager. Leave blank to use
# a private key file in the application data directory.
# APPLYPILOT_CREDENTIAL_KEY=
